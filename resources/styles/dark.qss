FrameSubMdi{
  background-color: #F3EEF3;
  border: 1px solid #5d1049;
}

QWidget#barra{
  background-color: #5d1049;
  color : #fff;


}

QWidget#barra QPushButton#btn_login{
  font: 600 7.5pt "Noto Sans";
  padding: 2px 10px;
  border-radius: 9px;
  border: 1px solid rgba(255, 255, 255, 140);
  color: #fff;
  background: rgba(255, 255, 255, 25);
}

QWidget#barra QPushButton#btn_login:hover{
  border-color: #fff;
  background: rgba(255, 255, 255, 60);
}

QWidget#barra QPushButton#btn_min, QWidget#barra QPushButton#btn_max, QWidget#barra QPushButton#btn_salir{
  border: none;
  border-radius: 4px;
  background: transparent;
}

QWidget#barra QPushButton#btn_min:hover, QWidget#barra QPushButton#btn_max:hover{
  background: rgba(255, 255, 255, 40);
}

QWidget#barra QPushButton#btn_salir:hover{
  background: #a32529;
}

QWidget#barra QLabel{
  color : #fff;

}

QWidget#barra QPushButton#btn_close{
  font: 8pt "Noto Sans";
  border-radius: 3px;
  border-width: 0px;
  color: rgb(255, 255, 255);
  background-color: transparent;
}

QWidget#barra QPushButton#btn_close:hover{
  color: rgb(255, 255, 255);
  background-color: #a32529;
}

QGroupBox#frame_Box_1 QPushButton{
  color : white;
  background-color: rgb(255, 0, 0);

}

QFrame#frame_sec QPushButton{
  min-height: 26px;
  padding: 0 16px;
  margin-top: 4px;
  border: none;
  border-top-left-radius: 7px;
  border-top-right-radius: 7px;
  background: transparent;
  color: rgba(255, 255, 255, 190);
  font: 600 9pt "Noto Sans";
}

QFrame#frame_sec QPushButton:hover {
  background: rgba(255, 255, 255, 30);
  color: #fff;
}

/* La pestaña activa se funde con la barra de abajo. */
QFrame#frame_sec QPushButton:checked {
  background: #F3EEF3;
  color: #5D1049;
}

/* ---- Barra de módulos y acciones ------------------------------------
   Misma paleta que core/tema.py (ver docs/roadmap_estilo.md). Va por
   objectName para no filtrarse a los módulos, que traen su propio estilo. */
QFrame#tool{
  background: #F3EEF3;
  border-bottom: 1px solid #D9CFD8;
}

QFrame#tool QPushButton{
  background: #FFFFFF;
  border: 1px solid #D2C7D1;
  border-radius: 7px;
  padding: 2px 12px;
  min-height: 20px;
  color: #2A2229;
  font: 8pt "Noto Sans";
}

QFrame#tool QPushButton:hover{
  border-color: #5D1049;
  color: #5D1049;
}

QFrame#tool QPushButton:checked{
  background: #F3E9F0;
  border-color: #5D1049;
  color: #5D1049;
  font-weight: 600;
}

QFrame#tool QPushButton:disabled{
  background: #EDE7EC;
  border-color: #E0D8DF;
  color: #8F8391;
}

QFrame#tool QLabel{
  color: #5D1049;
}

/* ---- Ingreso ---------------------------------------------------------- */
QWidget#Login{
  background: #F3EEF3;
  color: #2A2229;
}

QWidget#Login QLabel{
  color: #5E5360;
  font-size: 8.5pt;
}

QWidget#Login QLabel#login_ayuda{
  color: #5E5360;
  font-size: 8pt;
}

QWidget#Login QLineEdit{
  background: #FFFFFF;
  border: 1px solid #D2C7D1;
  border-radius: 7px;
  padding: 3px 8px;
  selection-background-color: #5D1049;
  selection-color: #fff;
}

QWidget#Login QLineEdit:focus{
  background: #FFFFFF;
  border: 1px solid #5D1049;
}

QWidget#Login QLineEdit:disabled{
  color: #8F8391;
}

QWidget#Login QPushButton#btn_login{
  background: #5D1049;
  border: 1px solid #5D1049;
  border-radius: 7px;
  padding: 4px 16px;
  color: #fff;
  font-weight: 600;
}

QWidget#Login QPushButton#btn_login:hover{
  background: #7C1C63;
  border-color: #7C1C63;
}

QWidget#Login QPushButton#btn_login:disabled{
  background: #E4DCE3;
  border-color: #E4DCE3;
  color: #8F8391;
}
